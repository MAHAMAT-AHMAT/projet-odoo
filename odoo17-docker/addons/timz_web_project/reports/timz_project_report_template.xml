<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_timz_project_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">

                        <!-- ═══════════════════════════════════════════════════
                             EN-TÊTE DU RAPPORT
                        ══════════════════════════════════════════════════ -->
                        <div class="row">
                            <div class="col-12 text-center mb-4">
                                <h2 style="color:#2c3e50; border-bottom: 3px solid #3498db; padding-bottom:8px;">
                                    FICHE PROJET WEB
                                </h2>
                                <h3 style="color:#3498db;">
                                    <t t-esc="o.name"/>
                                </h3>
                                <p class="text-muted">
                                    Référence : <strong><t t-esc="o.reference"/></strong>
                                </p>
                            </div>
                        </div>

                        <!-- ═══════════════════════════════════════════════════
                             BLOC 1 : INFORMATIONS GÉNÉRALES
                        ══════════════════════════════════════════════════ -->
                        <div class="row mt-4">
                            <div class="col-12">
                                <h4 style="background-color:#3498db; color:white; padding:6px 10px;">
                                    1. Informations générales
                                </h4>
                            </div>
                        </div>
                        <table class="table table-bordered table-sm">
                            <tbody>
                                <tr>
                                    <td class="bg-light" style="width:35%;"><strong>Client</strong></td>
                                    <td><t t-esc="o.client_id.name"/></td>
                                    <td class="bg-light"><strong>Email client</strong></td>
                                    <td><t t-esc="o.client_id.email or '—'"/></td>
                                </tr>
                                <tr>
                                    <td class="bg-light"><strong>Type de projet</strong></td>
                                    <td>
                                        <t t-if="o.project_type == 'website'">Site Web Vitrine</t>
                                        <t t-elif="o.project_type == 'ecommerce'">Site E-Commerce</t>
                                        <t t-elif="o.project_type == 'webapp'">Application Web</t>
                                        <t t-elif="o.project_type == 'api'">API / Web Service</t>
                                        <t t-elif="o.project_type == 'maintenance'">Maintenance / Évolution</t>
                                    </td>
                                    <td class="bg-light"><strong>Technologie</strong></td>
                                    <td>
                                        <t t-if="o.technology == 'django'">Django / Python</t>
                                        <t t-elif="o.technology == 'laravel'">Laravel / PHP</t>
                                        <t t-elif="o.technology == 'react'">React.js</t>
                                        <t t-elif="o.technology == 'vue'">Vue.js</t>
                                        <t t-elif="o.technology == 'angular'">Angular</t>
                                        <t t-elif="o.technology == 'nodejs'">Node.js</t>
                                        <t t-elif="o.technology == 'wordpress'">WordPress</t>
                                        <t t-elif="o.technology == 'odoo'">Odoo / Python</t>
                                        <t t-elif="o.technology == 'other'">Autre</t>
                                        <t t-else="">—</t>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="bg-light"><strong>Chef de projet</strong></td>
                                    <td><t t-esc="o.team_lead_id.name or '—'"/></td>
                                    <td class="bg-light"><strong>Priorité</strong></td>
                                    <td>
                                        <t t-if="o.priority == '0'">Normale</t>
                                        <t t-elif="o.priority == '1'">Haute</t>
                                        <t t-elif="o.priority == '2'">Urgente</t>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="bg-light"><strong>État</strong></td>
                                    <td>
                                        <t t-if="o.state == 'draft'">Brouillon</t>
                                        <t t-elif="o.state == 'in_progress'">En cours</t>
                                        <t t-elif="o.state == 'review'">En revue client</t>
                                        <t t-elif="o.state == 'delivered'">Livré</t>
                                        <t t-elif="o.state == 'invoiced'">Facturé</t>
                                        <t t-elif="o.state == 'cancelled'">Annulé</t>
                                    </td>
                                    <td class="bg-light"><strong>Avancement</strong></td>
                                    <td><t t-esc="o.progress"/>%</td>
                                </tr>
                            </tbody>
                        </table>

                        <!-- ═══════════════════════════════════════════════════
                             BLOC 2 : PLANIFICATION
                        ══════════════════════════════════════════════════ -->
                        <div class="row mt-4">
                            <div class="col-12">
                                <h4 style="background-color:#3498db; color:white; padding:6px 10px;">
                                    2. Planification
                                </h4>
                            </div>
                        </div>
                        <table class="table table-bordered table-sm">
                            <tbody>
                                <tr>
                                    <td class="bg-light" style="width:35%;"><strong>Date de début</strong></td>
                                    <td>
                                        <t t-esc="o.start_date"
                                           t-options='{"widget": "date"}'/>
                                        <t t-if="not o.start_date">—</t>
                                    </td>
                                    <td class="bg-light"><strong>Date de fin prévue</strong></td>
                                    <td>
                                        <t t-esc="o.end_date"
                                           t-options='{"widget": "date"}'/>
                                        <t t-if="not o.end_date">—</t>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="bg-light"><strong>Date limite client</strong></td>
                                    <td>
                                        <t t-esc="o.deadline"
                                           t-options='{"widget": "date"}'/>
                                        <t t-if="not o.deadline">—</t>
                                    </td>
                                    <td class="bg-light"><strong>Date de livraison effective</strong></td>
                                    <td>
                                        <t t-esc="o.actual_end_date"
                                           t-options='{"widget": "date"}'/>
                                        <t t-if="not o.actual_end_date">—</t>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <!-- ═══════════════════════════════════════════════════
                             BLOC 3 : BUDGET
                        ══════════════════════════════════════════════════ -->
                        <div class="row mt-4">
                            <div class="col-12">
                                <h4 style="background-color:#3498db; color:white; padding:6px 10px;">
                                    3. Budget
                                </h4>
                            </div>
                        </div>
                        <table class="table table-bordered table-sm">
                            <tbody>
                                <tr>
                                    <td class="bg-light" style="width:35%;"><strong>Budget contractuel</strong></td>
                                    <td>
                                        <t t-esc="'{:,.2f}'.format(o.budget)"/> €
                                    </td>
                                    <td class="bg-light"><strong>Montant facturé</strong></td>
                                    <td>
                                        <t t-esc="'{:,.2f}'.format(o.amount_invoiced)"/> €
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <!-- ═══════════════════════════════════════════════════
                             BLOC 4 : ÉQUIPE
                        ══════════════════════════════════════════════════ -->
                        <div class="row mt-4">
                            <div class="col-12">
                                <h4 style="background-color:#3498db; color:white; padding:6px 10px;">
                                    4. Équipe projet
                                </h4>
                            </div>
                        </div>
                        <table class="table table-bordered table-sm">
                            <thead class="bg-light">
                                <tr>
                                    <th>Rôle</th>
                                    <th>Nom</th>
                                    <th>Email</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td><strong>Chef de projet</strong></td>
                                    <td><t t-esc="o.team_lead_id.name or '—'"/></td>
                                    <td><t t-esc="o.team_lead_id.email or '—'"/></td>
                                </tr>
                                <t t-foreach="o.developer_ids" t-as="dev">
                                    <tr>
                                        <td>Développeur</td>
                                        <td><t t-esc="dev.name"/></td>
                                        <td><t t-esc="dev.email or '—'"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <!-- ═══════════════════════════════════════════════════
                             BLOC 5 : DESCRIPTION & LIVRABLES
                        ══════════════════════════════════════════════════ -->
                        <div class="row mt-4">
                            <div class="col-12">
                                <h4 style="background-color:#3498db; color:white; padding:6px 10px;">
                                    5. Description et Livrables
                                </h4>
                            </div>
                        </div>
                        <div class="border p-3 mb-3">
                            <strong>Description du projet :</strong><br/>
                            <t t-if="o.description">
                                <t t-raw="o.description"/>
                            </t>
                            <t t-else="">
                                <em>Aucune description renseignée.</em>
                            </t>
                        </div>
                        <div class="border p-3">
                            <strong>Livrables attendus :</strong><br/>
                            <t t-if="o.deliverables">
                                <t t-esc="o.deliverables"/>
                            </t>
                            <t t-else="">
                                <em>Non renseigné.</em>
                            </t>
                        </div>

                        <!-- ═══════════════════════════════════════════════════
                             PIED DE PAGE
                        ══════════════════════════════════════════════════ -->
                        <div class="row mt-5">
                            <div class="col-6 text-left">
                                <p style="border-top:1px solid #ccc; padding-top:8px;">
                                    Signature Chef de projet
                                </p>
                            </div>
                            <div class="col-6 text-right">
                                <p style="border-top:1px solid #ccc; padding-top:8px;">
                                    Signature Client
                                </p>
                            </div>
                        </div>

                        <div class="text-center text-muted mt-4" style="font-size:10px;">
                            Document généré par Timz &amp; Co — Système d'Information Odoo 17
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
