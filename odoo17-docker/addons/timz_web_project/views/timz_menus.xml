<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════════════════════════
         MENUS — Timz & Co
    ═══════════════════════════════════════════════════════════════════════ -->

    <!-- Menu racine -->
    <menuitem id="menu_timz_root"
              name="Timz &amp; Co"
              web_icon="timz_web_project,static/description/icon.png"
              sequence="30"
              groups="timz_web_project.group_timz_user"/>

    <!-- ── Tableau de bord ──────────────────────────────────────────────── -->
    <menuitem id="menu_timz_dashboard"
              name="Tableau de bord"
              parent="menu_timz_root"
              action="action_timz_dashboard_graph"
              sequence="1"
              groups="timz_web_project.group_timz_user"/>

    <!-- ── Demandes clients ─────────────────────────────────────────────── -->
    <menuitem id="menu_timz_requests"
              name="Demandes clients"
              parent="menu_timz_root"
              sequence="10"
              groups="timz_web_project.group_timz_user"/>

    <menuitem id="menu_timz_request_all"
              name="Toutes les demandes"
              parent="menu_timz_requests"
              action="action_timz_client_request"
              sequence="1"
              groups="timz_web_project.group_timz_user"/>

    <menuitem id="menu_timz_request_new"
              name="Nouvelle demande"
              parent="menu_timz_requests"
              action="action_timz_client_request"
              sequence="2"
              groups="timz_web_project.group_timz_user"/>

    <!-- ── Projets web ──────────────────────────────────────────────────── -->
    <menuitem id="menu_timz_projects"
              name="Projets Web"
              parent="menu_timz_root"
              sequence="20"
              groups="timz_web_project.group_timz_user"/>

    <menuitem id="menu_timz_project_all"
              name="Tous les projets"
              parent="menu_timz_projects"
              action="action_timz_web_project"
              sequence="1"
              groups="timz_web_project.group_timz_user"/>

    <!-- ── Rapports &amp; Statistiques ─────────────────────────────────── -->
    <menuitem id="menu_timz_reporting"
              name="Rapports"
              parent="menu_timz_root"
              sequence="30"
              groups="timz_web_project.group_timz_manager"/>

    <menuitem id="menu_timz_reporting_projects"
              name="Statistiques projets"
              parent="menu_timz_reporting"
              action="action_timz_dashboard_graph"
              sequence="1"
              groups="timz_web_project.group_timz_manager"/>

    <menuitem id="menu_timz_reporting_requests"
              name="Statistiques demandes"
              parent="menu_timz_reporting"
              action="action_timz_dashboard_requests"
              sequence="2"
              groups="timz_web_project.group_timz_manager"/>

    <!-- ── Configuration ────────────────────────────────────────────────── -->
    <menuitem id="menu_timz_config"
              name="Configuration"
              parent="menu_timz_root"
              sequence="99"
              groups="timz_web_project.group_timz_manager"/>

</odoo>
