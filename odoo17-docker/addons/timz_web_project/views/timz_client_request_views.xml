<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════════════════════════
         VUE LISTE — Demandes clients
    ═══════════════════════════════════════════════════════════════════════ -->
    <record id="view_timz_client_request_tree" model="ir.ui.view">
        <field name="name">timz.client.request.tree</field>
        <field name="model">timz.client.request</field>
        <field name="arch" type="xml">
            <tree string="Demandes clients"
                  decoration-success="state == 'won'"
                  decoration-danger="state == 'lost'"
                  decoration-info="state == 'proposal'">
                <field name="name"/>
                <field name="client_id"/>
                <field name="project_type"/>
                <field name="budget" optional="show"/>
                <field name="deadline" optional="show"/>
                <field name="user_id" widget="many2one_avatar_user" optional="show"/>
                <field name="state"
                       widget="badge"
                       decoration-success="state == 'won'"
                       decoration-danger="state == 'lost'"
                       decoration-info="state in ('proposal', 'qualified')"/>
                <field name="create_date" optional="hide"/>
            </tree>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════════
         VUE FORMULAIRE — Demandes clients
    ═══════════════════════════════════════════════════════════════════════ -->
    <record id="view_timz_client_request_form" model="ir.ui.view">
        <field name="name">timz.client.request.form</field>
        <field name="model">timz.client.request</field>
        <field name="arch" type="xml">
            <form string="Demande Client">
                <header>
                    <button name="action_qualify"
                            string="Qualifier"
                            type="object"
                            class="oe_highlight"
                            invisible="state != 'new'"
                            groups="timz_web_project.group_timz_user"/>
                    <button name="action_send_proposal"
                            string="Envoyer une proposition"
                            type="object"
                            class="oe_highlight"
                            invisible="state != 'qualified'"
                            groups="timz_web_project.group_timz_user"/>
                    <button name="action_mark_won"
                            string="Marquer Gagnée"
                            type="object"
                            class="oe_highlight"
                            invisible="state != 'proposal'"
                            groups="timz_web_project.group_timz_manager"/>
                    <button name="action_mark_lost"
                            string="Perdue"
                            type="object"
                            invisible="state in ('won', 'lost')"
                            groups="timz_web_project.group_timz_manager"/>
                    <button name="action_create_project"
                            string="Créer le Projet Web"
                            type="object"
                            class="oe_highlight"
                            invisible="state != 'won' or web_project_id != False"
                            groups="timz_web_project.group_timz_manager"/>
                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="new,qualified,proposal,won"/>
                </header>
                <sheet>
                    <!-- Smart buttons -->
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_crm_lead"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-handshake-o"
                                invisible="not crm_lead_id">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Opportunité</span>
                                <span class="o_stat_text">CRM</span>
                            </div>
                        </button>
                        <button name="action_view_sale_order"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-file-text-o"
                                invisible="not sale_order_id">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value">
                                    <field name="sale_order_count"/>
                                </span>
                                <span class="o_stat_text">Devis</span>
                            </div>
                        </button>
                        <button name="action_view_web_project"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-code"
                                invisible="not web_project_id">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Projet</span>
                                <span class="o_stat_text">Web</span>
                            </div>
                        </button>
                    </div>

                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Informations client">
                            <field name="client_id"/>
                            <field name="email"/>
                            <field name="phone"/>
                            <field name="user_id"/>
                        </group>
                        <group string="Détail de la demande">
                            <field name="project_type"/>
                            <field name="budget"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="deadline"/>
                            <field name="priority" widget="priority"/>
                            <field name="kanban_state" widget="state_selection"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Description du besoin">
                            <field name="description"
                                   placeholder="Décrivez le besoin du client en détail..."/>
                        </page>
                        <page string="Notes internes"
                              groups="timz_web_project.group_timz_manager">
                            <field name="note"
                                   placeholder="Notes internes (non visibles par le client)..."/>
                        </page>
                        <page string="Liens">
                            <group>
                                <field name="crm_lead_id" readonly="1"/>
                                <field name="sale_order_id" readonly="1"/>
                                <field name="web_project_id" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════════
         VUE KANBAN — Demandes clients
    ═══════════════════════════════════════════════════════════════════════ -->
    <record id="view_timz_client_request_kanban" model="ir.ui.view">
        <field name="name">timz.client.request.kanban</field>
        <field name="model">timz.client.request</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state">
                <field name="name"/>
                <field name="client_id"/>
                <field name="project_type"/>
                <field name="budget"/>
                <field name="deadline"/>
                <field name="user_id"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click oe_kanban_card o_kanban_record">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="name"/>
                                        </strong>
                                    </div>
                                </div>
                                <div class="o_kanban_record_body">
                                    <div><field name="client_id"/></div>
                                    <div><field name="project_type"/></div>
                                    <div t-if="record.deadline.value">
                                        <field name="deadline"/>
                                    </div>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_right">
                                        <field name="user_id" widget="many2one_avatar_user"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════════
         VUE RECHERCHE — Demandes clients
    ═══════════════════════════════════════════════════════════════════════ -->
    <record id="view_timz_client_request_search" model="ir.ui.view">
        <field name="name">timz.client.request.search</field>
        <field name="model">timz.client.request</field>
        <field name="arch" type="xml">
            <search string="Rechercher une demande">
                <field name="name" string="Référence"/>
                <field name="client_id" string="Client"/>
                <field name="user_id" string="Commercial"/>
                <field name="project_type" string="Type de projet"/>
                <separator/>
                <filter string="Nouvelles" name="filter_new" domain="[('state','=','new')]"/>
                <filter string="Qualifiées" name="filter_qualified" domain="[('state','=','qualified')]"/>
                <filter string="En proposition" name="filter_proposal" domain="[('state','=','proposal')]"/>
                <filter string="Gagnées" name="filter_won" domain="[('state','=','won')]"/>
                <filter string="Perdues" name="filter_lost" domain="[('state','=','lost')]"/>
                <separator/>
                <filter string="Les miennes" name="filter_my" domain="[('user_id','=',uid)]"/>
                <filter string="Haute priorité" name="filter_priority" domain="[('priority','in',['1','2'])]"/>
                <group expand="0" string="Regrouper par">
                    <filter string="État" name="group_state" context="{'group_by':'state'}"/>
                    <filter string="Type de projet" name="group_type" context="{'group_by':'project_type'}"/>
                    <filter string="Commercial" name="group_user" context="{'group_by':'user_id'}"/>
                    <filter string="Client" name="group_client" context="{'group_by':'client_id'}"/>
                    <filter string="Mois de création" name="group_month" context="{'group_by':'create_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════════
         VUE GRAPHIQUE — Demandes clients
    ═══════════════════════════════════════════════════════════════════════ -->
    <record id="view_timz_client_request_graph" model="ir.ui.view">
        <field name="name">timz.client.request.graph</field>
        <field name="model">timz.client.request</field>
        <field name="arch" type="xml">
            <graph string="Statistiques des demandes" type="bar">
                <field name="project_type" type="row"/>
                <field name="state" type="col"/>
                <field name="budget" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════════
         VUE PIVOT — Demandes clients
    ═══════════════════════════════════════════════════════════════════════ -->
    <record id="view_timz_client_request_pivot" model="ir.ui.view">
        <field name="name">timz.client.request.pivot</field>
        <field name="model">timz.client.request</field>
        <field name="arch" type="xml">
            <pivot string="Analyse des demandes">
                <field name="project_type" type="row"/>
                <field name="state" type="col"/>
                <field name="budget" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════════
         ACTION — Demandes clients
    ═══════════════════════════════════════════════════════════════════════ -->
    <record id="action_timz_client_request" model="ir.actions.act_window">
        <field name="name">Demandes clients</field>
        <field name="res_model">timz.client.request</field>
        <field name="view_mode">tree,kanban,form,graph,pivot</field>
        <field name="search_view_id" ref="view_timz_client_request_search"/>
        <field name="context">{'search_default_filter_my': 0}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créez votre première demande client !
            </p>
            <p>
                Saisissez les besoins de vos prospects et clients pour initier
                le cycle commercial de Timz &amp; Co.
            </p>
        </field>
    </record>

</odoo>
