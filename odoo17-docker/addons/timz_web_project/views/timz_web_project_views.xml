<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════════════════════════
         VUE LISTE — Projets web
    ═══════════════════════════════════════════════════════════════════════ -->
    <record id="view_timz_web_project_tree" model="ir.ui.view">
        <field name="name">timz.web.project.tree</field>
        <field name="model">timz.web.project</field>
        <field name="arch" type="xml">
            <tree string="Projets Web"
                  decoration-success="state == 'invoiced'"
                  decoration-info="state == 'in_progress'"
                  decoration-warning="state == 'review'"
                  decoration-danger="state == 'cancelled'">
                <field name="reference"/>
                <field name="name"/>
                <field name="client_id"/>
                <field name="project_type"/>
                <field name="technology" optional="show"/>
                <field name="team_lead_id" widget="many2one_avatar_user" optional="show"/>
                <field name="start_date" optional="show"/>
                <field name="deadline" optional="show"/>
                <field name="budget" optional="show"/>
                <field name="state"
                       widget="badge"
                       decoration-success="state == 'invoiced'"
                       decoration-info="state == 'in_progress'"
                       decoration-warning="state == 'review'"
                       decoration-danger="state == 'cancelled'"/>
            </tree>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════════
         VUE FORMULAIRE — Projets web
    ═══════════════════════════════════════════════════════════════════════ -->
    <record id="view_timz_web_project_form" model="ir.ui.view">
        <field name="name">timz.web.project.form</field>
        <field name="model">timz.web.project</field>
        <field name="arch" type="xml">
            <form string="Projet Web">
                <header>
                    <!-- Boutons workflow -->
                    <button name="action_start"
                            string="Démarrer le projet"
                            type="object"
                            class="oe_highlight"
                            invisible="state != 'draft'"
                            groups="timz_web_project.group_timz_manager"/>
                    <button name="action_submit_review"
                            string="Soumettre à la revue client"
                            type="object"
                            class="oe_highlight"
                            invisible="state != 'in_progress'"
                            groups="timz_web_project.group_timz_manager"/>
                    <button name="action_deliver"
                            string="Confirmer la livraison"
                            type="object"
                            class="oe_highlight"
                            invisible="state != 'review'"
                            groups="timz_web_project.group_timz_manager"/>
                    <button name="action_create_invoice"
                            string="Créer la facture"
                            type="object"
                            class="oe_highlight"
                            invisible="state not in ('delivered',)"
                            groups="timz_web_project.group_timz_manager"/>
                    <button name="action_cancel"
                            string="Annuler"
                            type="object"
                            invisible="state in ('invoiced', 'cancelled')"
                            groups="timz_web_project.group_timz_manager"/>
                    <button name="action_reset_draft"
                            string="Remettre en brouillon"
                            type="object"
                            invisible="state != 'cancelled'"
                            groups="timz_web_project.group_timz_manager"/>
                    <button name="action_print_report"
                            string="Imprimer la fiche"
                            type="object"
                            icon="fa-print"
                            groups="timz_web_project.group_timz_user"/>
                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="draft,in_progress,review,delivered,invoiced"/>
                </header>
                <sheet>
                    <!-- Champs requis pour les expressions invisible — accessibles à tous les groupes -->
                    <field name="odoo_project_id" invisible="1"/>
                    <field name="invoice_count" invisible="1"/>
                    <!-- Smart buttons -->
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_tasks"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-tasks"
                                invisible="not odoo_project_id">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value">
                                    <field name="task_count"/>
                                </span>
                                <span class="o_stat_text">Tâches</span>
                            </div>
                        </button>
                        <button name="action_view_invoices"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-file-invoice"
                                invisible="invoice_count == 0"
                                groups="timz_web_project.group_timz_manager">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value">
                                    <field name="invoice_count"/>
                                </span>
                                <span class="o_stat_text">Factures</span>
                            </div>
                        </button>
                    </div>

                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name"
                                   placeholder="Nom du projet..."/>
                        </h1>
                        <div class="o_row">
                            <field name="reference" readonly="1"/>
                            <field name="priority" widget="priority"/>
                        </div>
                    </div>

                    <group>
                        <group string="Informations générales">
                            <field name="client_id"/>
                            <field name="project_type"/>
                            <field name="technology"/>
                            <field name="kanban_state" widget="state_selection"/>
                        </group>
                        <group string="Planification">
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="deadline"/>
                            <field name="actual_end_date"
                                   invisible="state not in ('delivered','invoiced')"/>
                            <field name="budget"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="amount_invoiced"
                                   invisible="state not in ('invoiced',)"
                                   groups="timz_web_project.group_timz_manager"/>
                        </group>
                    </group>

                    <!-- Barre de progression -->
                    <group string="Avancement du projet">
                        <field name="progress" string="Avancement (%)"/>
                    </group>

                    <notebook>
                        <page string="Équipe projet">
                            <group>
                                <field name="team_lead_id"/>
                                <field name="developer_ids" widget="many2many_tags"/>
                            </group>
                        </page>
                        <page string="Description &amp; Livrables">
                            <group>
                                <label for="description"/>
                                <field name="description" nolabel="1"/>
                                <label for="deliverables"/>
                                <field name="deliverables"
                                       nolabel="1"
                                       placeholder="Listez ici les livrables attendus (ex: code source, documentation, déploiement)..."/>
                            </group>
                        </page>
                        <page string="Liens &amp; Documents"
                              groups="timz_web_project.group_timz_manager">
                            <group>
                                <field name="client_request_id" readonly="1"/>
                                <field name="sale_order_id" readonly="1"/>
                                <field name="odoo_project_id" readonly="1"/>
                            </group>
                            <field name="invoice_ids" readonly="1">
                                <tree>
                                    <field name="name"/>
                                    <field name="invoice_date"/>
                                    <field name="amount_total"/>
                                    <field name="state"
                                           widget="badge"
                                           decoration-success="state == 'posted'"
                                           decoration-warning="state == 'draft'"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════════
         VUE KANBAN — Projets web
    ═══════════════════════════════════════════════════════════════════════ -->
    <record id="view_timz_web_project_kanban" model="ir.ui.view">
        <field name="name">timz.web.project.kanban</field>
        <field name="model">timz.web.project</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state">
                <field name="name"/>
                <field name="reference"/>
                <field name="client_id"/>
                <field name="project_type"/>
                <field name="technology"/>
                <field name="deadline"/>
                <field name="team_lead_id"/>
                <field name="progress"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click oe_kanban_card o_kanban_record">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <small class="o_kanban_record_subtitle text-muted">
                                            <field name="reference"/>
                                        </small>
                                        <strong class="o_kanban_record_title">
                                            <field name="name"/>
                                        </strong>
                                    </div>
                                </div>
                                <div class="o_kanban_record_body">
                                    <div><field name="client_id"/></div>
                                    <div><field name="technology"/></div>
                                    <div>Avancement : <field name="progress"/>%</div>
                                    <div t-if="record.deadline.value">
                                        <field name="deadline"/>
                                    </div>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_right">
                                        <field name="team_lead_id" widget="many2one_avatar_user"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════════
         VUE GRAPHIQUE — Projets web
    ═══════════════════════════════════════════════════════════════════════ -->
    <record id="view_timz_web_project_graph" model="ir.ui.view">
        <field name="name">timz.web.project.graph</field>
        <field name="model">timz.web.project</field>
        <field name="arch" type="xml">
            <graph string="Statistiques projets web" type="bar">
                <field name="project_type" type="row"/>
                <field name="state" type="col"/>
                <field name="budget" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════════
         VUE PIVOT — Projets web
    ═══════════════════════════════════════════════════════════════════════ -->
    <record id="view_timz_web_project_pivot" model="ir.ui.view">
        <field name="name">timz.web.project.pivot</field>
        <field name="model">timz.web.project</field>
        <field name="arch" type="xml">
            <pivot string="Analyse des projets">
                <field name="project_type" type="row"/>
                <field name="technology" type="row"/>
                <field name="state" type="col"/>
                <field name="budget" type="measure"/>
                <field name="amount_invoiced" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════════
         VUE RECHERCHE — Projets web
    ═══════════════════════════════════════════════════════════════════════ -->
    <record id="view_timz_web_project_search" model="ir.ui.view">
        <field name="name">timz.web.project.search</field>
        <field name="model">timz.web.project</field>
        <field name="arch" type="xml">
            <search string="Rechercher un projet">
                <field name="name" string="Nom du projet"/>
                <field name="reference" string="Référence"/>
                <field name="client_id" string="Client"/>
                <field name="team_lead_id" string="Chef de projet"/>
                <field name="project_type" string="Type"/>
                <field name="technology" string="Technologie"/>
                <separator/>
                <filter string="Brouillons" name="filter_draft" domain="[('state','=','draft')]"/>
                <filter string="En cours" name="filter_inprogress" domain="[('state','=','in_progress')]"/>
                <filter string="En revue" name="filter_review" domain="[('state','=','review')]"/>
                <filter string="Livrés" name="filter_delivered" domain="[('state','=','delivered')]"/>
                <filter string="Facturés" name="filter_invoiced" domain="[('state','=','invoiced')]"/>
                <filter string="Annulés" name="filter_cancelled" domain="[('state','=','cancelled')]"/>
                <separator/>
                <filter string="Mes projets" name="filter_my" domain="[('team_lead_id','=',uid)]"/>
                <filter string="Haute priorité" name="filter_priority" domain="[('priority','in',['1','2'])]"/>
                <group expand="0" string="Regrouper par">
                    <filter string="État" name="group_state" context="{'group_by':'state'}"/>
                    <filter string="Type de projet" name="group_type" context="{'group_by':'project_type'}"/>
                    <filter string="Technologie" name="group_tech" context="{'group_by':'technology'}"/>
                    <filter string="Chef de projet" name="group_lead" context="{'group_by':'team_lead_id'}"/>
                    <filter string="Client" name="group_client" context="{'group_by':'client_id'}"/>
                    <filter string="Mois de début" name="group_month" context="{'group_by':'start_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════════
         ACTION — Projets web
    ═══════════════════════════════════════════════════════════════════════ -->
    <record id="action_timz_web_project" model="ir.actions.act_window">
        <field name="name">Projets Web</field>
        <field name="res_model">timz.web.project</field>
        <field name="view_mode">tree,kanban,form,graph,pivot</field>
        <field name="view_id" ref="view_timz_web_project_tree"/>
        <field name="search_view_id" ref="view_timz_web_project_search"/>
        <field name="context">{'search_default_filter_inprogress': 0}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aucun projet web pour l'instant.
            </p>
            <p>
                Créez un projet depuis une demande client gagnée ou directement
                depuis ce menu.
            </p>
        </field>
    </record>

</odoo>
