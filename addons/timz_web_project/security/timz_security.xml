<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- ═══════════════════════════════════════════════════════════════════
             Catégorie de module
        ════════════════════════════════════════════════════════════════════ -->
        <record id="module_category_timz" model="ir.module.category">
            <field name="name">Timz Web Project</field>
            <field name="description">Gestion des projets web — Timz &amp; Co</field>
            <field name="sequence">20</field>
        </record>

        <!-- ═══════════════════════════════════════════════════════════════════
             Groupes de sécurité
        ════════════════════════════════════════════════════════════════════ -->

        <!-- Groupe Utilisateur : lecture + saisie demandes, consultation projets -->
        <record id="group_timz_user" model="res.groups">
            <field name="name">Utilisateur</field>
            <field name="category_id" ref="module_category_timz"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Accès en lecture/écriture sur les demandes clients et en lecture sur les projets web.</field>
        </record>

        <!-- Groupe Manager : accès complet, création projets, facturation -->
        <record id="group_timz_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="category_id" ref="module_category_timz"/>
            <field name="implied_ids" eval="[(4, ref('group_timz_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_admin'))]"/>
            <field name="comment">Accès complet : gestion des projets, facturation, rapports et configuration.</field>
        </record>

        <!-- ═══════════════════════════════════════════════════════════════════
             Règles d'accès par enregistrement (record rules)
        ════════════════════════════════════════════════════════════════════ -->

        <!-- Utilisateur : voit uniquement ses demandes -->
        <record id="rule_timz_request_user" model="ir.rule">
            <field name="name">Demandes clients — Utilisateur (propres enregistrements)</field>
            <field name="model_id" ref="model_timz_client_request"/>
            <field name="groups" eval="[(4, ref('group_timz_user'))]"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Manager : voit toutes les demandes -->
        <record id="rule_timz_request_manager" model="ir.rule">
            <field name="name">Demandes clients — Manager (tous les enregistrements)</field>
            <field name="model_id" ref="model_timz_client_request"/>
            <field name="groups" eval="[(4, ref('group_timz_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- Utilisateur : voit les projets où il est développeur ou chef -->
        <record id="rule_timz_project_user" model="ir.rule">
            <field name="name">Projets web — Utilisateur (équipe du projet)</field>
            <field name="model_id" ref="model_timz_web_project"/>
            <field name="groups" eval="[(4, ref('group_timz_user'))]"/>
            <field name="domain_force">
                ['|', ('team_lead_id', '=', user.id), ('developer_ids', 'in', [user.id])]
            </field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Manager : voit tous les projets -->
        <record id="rule_timz_project_manager" model="ir.rule">
            <field name="name">Projets web — Manager (tous les enregistrements)</field>
            <field name="model_id" ref="model_timz_web_project"/>
            <field name="groups" eval="[(4, ref('group_timz_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

    </data>
</odoo>
