<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════════════════════════
         TABLEAU DE BORD — Timz & Co
         Vue synthétique affichant les KPIs clés du module
    ═══════════════════════════════════════════════════════════════════════ -->
    <record id="view_timz_dashboard" model="ir.ui.view">
        <field name="name">timz.dashboard</field>
        <field name="model">timz.web.project</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <form string="Tableau de bord Timz &amp; Co" create="false">
                <sheet>
                    <div class="o_view_nocontent">
                    </div>
                    <h2 class="text-center mt16 mb16">
                        Tableau de bord — Timz &amp; Co
                    </h2>

                    <!-- KPI Cards -->
                    <div class="row mt16">
                        <!-- Projets en cours -->
                        <div class="col-lg-3 col-md-6 col-sm-12">
                            <div class="o_kanban_primary_left bg-info text-white p-3 rounded">
                                <div class="o_primary">
                                    <span class="fa fa-code fa-2x"/>
                                </div>
                                <div class="o_kanban_primary_right">
                                    <strong>Projets en cours</strong>
                                </div>
                            </div>
                        </div>
                        <!-- Projets livrés -->
                        <div class="col-lg-3 col-md-6 col-sm-12">
                            <div class="o_kanban_primary_left bg-success text-white p-3 rounded">
                                <div class="o_primary">
                                    <span class="fa fa-check-circle fa-2x"/>
                                </div>
                                <div class="o_kanban_primary_right">
                                    <strong>Projets livrés</strong>
                                </div>
                            </div>
                        </div>
                        <!-- En revue client -->
                        <div class="col-lg-3 col-md-6 col-sm-12">
                            <div class="o_kanban_primary_left bg-warning text-white p-3 rounded">
                                <div class="o_primary">
                                    <span class="fa fa-eye fa-2x"/>
                                </div>
                                <div class="o_kanban_primary_right">
                                    <strong>En revue client</strong>
                                </div>
                            </div>
                        </div>
                        <!-- Facturés -->
                        <div class="col-lg-3 col-md-6 col-sm-12">
                            <div class="o_kanban_primary_left bg-primary text-white p-3 rounded">
                                <div class="o_primary">
                                    <span class="fa fa-file-invoice fa-2x"/>
                                </div>
                                <div class="o_kanban_primary_right">
                                    <strong>Facturés</strong>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Graphiques intégrés -->
                    <div class="row mt24">
                        <div class="col-12">
                            <h4>Répartition des projets par type</h4>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action tableau de bord : graphique projets par état -->
    <record id="action_timz_dashboard_graph" model="ir.actions.act_window">
        <field name="name">Tableau de bord — Projets</field>
        <field name="res_model">timz.web.project</field>
        <field name="view_mode">graph,pivot,tree</field>
        <field name="context">{}</field>
    </record>

    <!-- Action tableau de bord : graphique demandes par état -->
    <record id="action_timz_dashboard_requests" model="ir.actions.act_window">
        <field name="name">Tableau de bord — Demandes</field>
        <field name="res_model">timz.client.request</field>
        <field name="view_mode">graph,pivot,tree</field>
        <field name="context">{}</field>
    </record>

</odoo>
